CONTAINER_NAME=dashboard-gen

TZ=America/Toronto

HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace_me
WEATHER_ENTITY=weather.forecast_home
CALENDAR_ENTITY=calendar.example
TODO_ENTITY=todo.daily_to_do

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:32b

COMFY_URL=http://comfyui:8188

# R2 offline adapter: deployment/SDK installation requires separate approval.
# No direct backend fallback. Token is private; use an operator-created value.
GPU_RUNNER_URL=http://replace-with-approved-runner:8790
GPU_RUNNER_TOKEN=replace_with_private_high_entropy_runner_token
GPU_RUNNER_OLLAMA_TARGET=ollama
GPU_RUNNER_WALLPAPER_TARGET=wallpaper
GPU_RUNNER_WAIT_SECONDS=3600
GPU_RUNNER_CLIENT_STATE=/var/lib/dashboard-gpu-client

EPD_PUSH_URL=http://epd-device.local/bin
EPD_PUSH_ENABLED=0
EPD_PUSH_FAIL_HARD=0
EPD_ROTATE_CW=270

COMFY_WORKFLOW_FILE=/app/workflows/picture_api.json
COMFY_INPUT_IMAGE=portrait.jpg
DEBIAN_FRONTEND=noninteractive

OUTPUT_DIR=/opt/homepage/generated
WORKFLOWS_DIR=/opt/dashboard-gen/workflows
ASSETS_DIR=/opt/dashboard-gen/assets
FRAME_TOOLS_DIR=/opt/frame-tools

HOST_PORT=8787
CONTAINER_PORT=8787
